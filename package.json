{
  "name": "solar-light-app",
  "version": "1.0.0",
  "description": "Solar street light installation tracker \u2014 Karak Highway Package 2A",
  "scripts": {
    "build": "node scripts/build.js",
    "import": "node scripts/import-xlsx.js data/Solar_Street_Lighting_Installation_Planning_1.xlsx && node scripts/build.js",
    "test": "node scripts/build.js && node --test tests/logic.test.js tests/backend.test.js",
    "test:e2e": "node scripts/build.js && node --test --test-concurrency=1 --test-timeout=180000 tests/e2e.test.js",
    "test:all": "npm test && npm run test:e2e",
    "serve": "node tests/e2e-server.js 8080"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "exifr": "^7.1.3",
    "piexifjs": "^1.0.6",
    "xlsx": "^0.18.5"
  },
  "private": true
}
